.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 40rpx;
  background: #f6f2e9;
}

.card {
  margin-bottom: 24rpx;
  padding: 8rpx 28rpx;
  border: 1rpx solid #e7dfd0;
  border-radius: 18rpx;
  background: #fbf8f2;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #ece5d8;
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  display: flex;
  flex-direction: column;
}

.label {
  color: #4e473c;
  font-size: 28rpx;
}

.sub {
  margin-top: 4rpx;
  color: #958c7d;
  font-size: 22rpx;
}

.picker {
  min-width: 150rpx;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  background: #fffdf7;
  color: #2e4d96;
  font-size: 28rpx;
  text-align: center;
}

.input {
  width: 320rpx;
  height: 60rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #fffdf7;
  color: #292520;
  font-size: 28rpx;
  text-align: right;
}

.section-label {
  display: block;
  padding: 22rpx 0 10rpx;
  color: #6c6457;
  font-size: 26rpx;
}

.day-row {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 20rpx;
}

.day {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin: 8rpx 16rpx 0 0;
  border: 1rpx solid #d8d0c0;
  border-radius: 50%;
  color: #6c6457;
  font-size: 26rpx;
}

.day.active {
  border-color: #2e4d96;
  background: #2e4d96;
  color: #fbf8f2;
}

.error {
  display: block;
  margin: 4rpx 8rpx 0;
  color: #b23b22;
  font-size: 24rpx;
  line-height: 1.5;
}

.hint {
  display: block;
  margin: 10rpx 8rpx 0;
  color: #958c7d;
  font-size: 23rpx;
  line-height: 1.6;
}

.save {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 40rpx;
  border-radius: 12rpx;
  background: #2a2723;
  color: #fff;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.save:active {
  background: #37332d;
}

.reset {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  color: #a74b20;
  font-size: 26rpx;
}

.reset:active {
  background: rgba(167, 75, 32, 0.06);
}
