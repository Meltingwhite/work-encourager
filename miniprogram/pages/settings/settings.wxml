<view class="page">
  <view class="card">
    <view class="row">
      <text class="label">上班时间</text>
      <picker mode="time" value="{{start}}" bindchange="onStartChange">
        <view class="picker">{{start}}</view>
      </picker>
    </view>
    <view class="row">
      <text class="label">下班时间</text>
      <picker mode="time" value="{{end}}" bindchange="onEndChange">
        <view class="picker">{{end}}</view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="row-main">
        <text class="label">午休</text>
        <text class="sub">{{lunchEnabled ? '午休不计入工时' : '全天连续工作'}}</text>
      </view>
      <switch checked="{{lunchEnabled}}" color="#2e4d96" bindchange="onLunchChange" />
    </view>
    <block wx:if="{{lunchEnabled}}">
      <view class="row">
        <text class="label">午休开始</text>
        <picker mode="time" value="{{lunchStart}}" bindchange="onLunchStartChange">
          <view class="picker">{{lunchStart}}</view>
        </picker>
      </view>
      <view class="row">
        <text class="label">午休结束</text>
        <picker mode="time" value="{{lunchEnd}}" bindchange="onLunchEndChange">
          <view class="picker">{{lunchEnd}}</view>
        </picker>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="row">
      <text class="label">时薪（元）</text>
      <input class="input" type="digit" value="{{hourly}}" bindinput="onHourlyInput" placeholder="0.00" />
    </view>
    <view class="row">
      <text class="label">愿望物品</text>
      <input class="input" value="{{itemName}}" maxlength="12" bindinput="onItemNameInput" placeholder="一件T恤" />
    </view>
    <view class="row">
      <text class="label">愿望价格（元）</text>
      <input class="input" type="digit" value="{{itemPrice}}" bindinput="onItemPriceInput" placeholder="0.00" />
    </view>
  </view>

  <view class="card">
    <text class="section-label">工作日</text>
    <view class="day-row">
      <view
        wx:for="{{days}}"
        wx:key="value"
        class="day {{item.active ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onDayTap"
      >{{item.label}}</view>
    </view>
  </view>

  <text wx:if="{{error}}" class="error">{{error}}</text>
  <text class="hint">午休关闭时按连续工作计算；所有设置只保存在本机，不会上传。</text>

  <button class="save" bindtap="onSave">保存</button>
  <button class="reset" bindtap="onReset">恢复默认</button>
</view>
